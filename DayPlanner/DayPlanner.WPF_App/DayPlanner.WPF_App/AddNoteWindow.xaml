<Window x:Class="DayPlanner.WPF_App.AddNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task editing" Height="260" Width="360" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Time (HH:mm):" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="TxtTime" Width="200" Text="09:00"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Type:" VerticalAlignment="Center" Width="100"/>
            <ComboBox x:Name="CmbType" Width="200" SelectedIndex="0">
                <ComboBoxItem>Study</ComboBoxItem>
                <ComboBoxItem>Work</ComboBoxItem>
                <ComboBoxItem>Personal</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Vertical">
            <TextBlock Text="Text:" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtText" AcceptsReturn="True" TextWrapping="Wrap" Height="120"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnDelete" Content="Delete" Width="80" Margin="0,0,8,0" Click="BtnDelete_Click"/>
            <Button x:Name="BtnOk" Content="OK" Width="80" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>