<Window x:Class="RpsTournament.WpfApp.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Your Name" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Please enter your name (2–30 characters):" Margin="0,0,0,6"/>
            <TextBox x:Name="NameTextBox" Width="300" MinWidth="220" MaxLength="30" TextChanged="NameTextBox_TextChanged"/>
            <TextBlock x:Name="ErrorText" Foreground="Tomato" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="6" Click="CancelButton_Click"/>
            <Button x:Name="OkButton" Content="OK" Width="90" Margin="6" Click="OkButton_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>