<Window x:Class="RpsTournament.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RpsTournament.Core;assembly=RpsTournament.Core"
        Title="RPS Tournament" Height="520" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#FF0F1725" FontFamily="Segoe UI">
    <Grid Margin="18">
        <!-- Left: controls (now full width) -->
        <Border CornerRadius="10" Background="#FFF7F7F7" Padding="16" Margin="6">
            <StackPanel>
                <TextBlock Text="Make your move" FontSize="18" FontWeight="Bold" Foreground="#222"/>
                <TextBlock Text="Choose rock, paper or scissors — play against the computer!" FontSize="12" Foreground="#444" Margin="0,6,0,8"/>

                <UniformGrid Columns="3" Margin="0,8,0,12" HorizontalAlignment="Center">
                    <Button Content="Rock" Command="{Binding PlayCommand}" CommandParameter="{x:Static core:Move.Rock}" Margin="6" />
                    <Button Content="Paper" Command="{Binding PlayCommand}" CommandParameter="{x:Static core:Move.Paper}" Margin="6" />
                    <Button Content="Scissors" Command="{Binding PlayCommand}" CommandParameter="{x:Static core:Move.Scissors}" Margin="6" />
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button Content="New Round" Command="{Binding NewRoundCommand}" Margin="6"/>
                    <Button Content="Clear Log" Command="{Binding ClearCommand}" Margin="6"/>
                </StackPanel>

                <Separator Margin="0,12"/>

                <TextBlock Text="Match Log" FontWeight="SemiBold" Margin="0,8,0,6"/>
                <ListBox ItemsSource="{Binding Log}" Height="200"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>