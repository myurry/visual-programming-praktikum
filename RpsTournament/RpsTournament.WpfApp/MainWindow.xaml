<Window x:Class="RpsTournament.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RPS Tournament" Height="520" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#FF0F1725" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: controls -->
        <Border CornerRadius="10" Background="#FFF7F7F7" Padding="16" Margin="6">
            <StackPanel>
                <TextBlock Text="Make your move" FontSize="18" FontWeight="Bold" Foreground="#222"/>
                <TextBlock Text="Choose rock, paper or scissors — play against the computer!" FontSize="12" Foreground="#444" Margin="0,6,0,8"/>

                <UniformGrid Columns="3" Margin="0,8,0,12" HorizontalAlignment="Center">
                    <Button Content="Rock" Command="{Binding PlayCommand}" CommandParameter="Rock" Margin="6" />
                    <Button Content="Paper" Command="{Binding PlayCommand}" CommandParameter="Paper" Margin="6" />
                    <Button Content="Scissors" Command="{Binding PlayCommand}" CommandParameter="Scissors" Margin="6" />
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button Content="New Round" Command="{Binding NewRoundCommand}" Margin="6"/>
                    <Button Content="Clear Log" Command="{Binding ClearCommand}" Margin="6"/>
                </StackPanel>

                <Separator Margin="0,12"/>

                <TextBlock Text="Match Log" FontWeight="SemiBold" Margin="0,8,0,6"/>
                <ListBox ItemsSource="{Binding Log}" Height="200"/>
            </StackPanel>
        </Border>

        <!-- Right: scoreboard -->
        <Border Grid.Column="1" CornerRadius="10" Background="#2B3440" Padding="16" Margin="6">
            <StackPanel>
                <TextBlock Text="Scoreboard" FontSize="16" FontWeight="Bold" Foreground="#E6F8FF"/>
                <StackPanel Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="You:" Foreground="#CFE9FF"/>
                        <TextBlock Text="{Binding PlayerScore}" FontWeight="Bold" Margin="10,0,0,0" Foreground="#E8FFD6"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Opponent:" Foreground="#CFE9FF"/>
                        <TextBlock Text="{Binding ComputerScore}" FontWeight="Bold" Margin="10,0,0,0" Foreground="#FFD6E6"/>
                    </StackPanel>
                </StackPanel>

                <Separator Margin="0,12"/>
                <TextBlock Text="{Binding SeriesWinner}" Foreground="#FFF3B0" FontWeight="SemiBold" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>