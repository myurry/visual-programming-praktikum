<Window x:Class="KiviPaber.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KiviPaber.WpfApp.ViewModels;assembly=KiviPaber.WpfApp"
        Title="Rock Paper Scissors" Height="450" Width="340">
    <Window.Resources>
        <!-- ViewModel instance as a resource -->
        <vm:BattleViewModel x:Key="BattleVM" />
    </Window.Resources>

    <!-- set DataContext from the resource -->
    <Window.DataContext>
        <StaticResource ResourceKey="BattleVM" />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/> <!-- log area -->
            <RowDefinition Height="Auto"/> <!-- buttons area -->
        </Grid.RowDefinitions>

        <Grid.Triggers>
            <!-- Click on empty grid to reset all buttons to full opacity -->
            <EventTrigger RoutedEvent="MouseLeftButtonDown">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RockButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="PaperButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="ScissorsButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- Scrollable log (ListBox has built-in ScrollViewer) -->
        <ListBox Grid.Row="0"
                 ItemsSource="{Binding Log}"
                 Margin="8"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="{Binding Number}" Width="32"/>
                        <TextBlock Text="{Binding PlayerMove}" Width="80"/>
                        <TextBlock Text="→" Margin="6,0"/>
                        <TextBlock Text="{Binding ComputerMove}" Width="80"/>
                        <TextBlock Text="{Binding Result}" Margin="8,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Buttons row -->
        <UniformGrid Grid.Row="1" Columns="3" HorizontalAlignment="Center" Margin="10" Height="94" Width="288">
            <Button x:Name="RockButton" Click="RockButton_Click" Height="94" Width="96" Padding="0">
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Click">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RockButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="PaperButton" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="ScissorsButton" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
                <TextBlock Text="🌕" FontSize="36" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>

            <Button x:Name="PaperButton" Click="PaperButton_Click" Height="94" Width="96" Padding="0">
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Click">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PaperButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="RockButton" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="ScissorsButton" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
                <TextBlock Text="📃" FontSize="36" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>

            <Button x:Name="ScissorsButton" Click="ScissorsButton_Click" Height="94" Width="96" Padding="0">
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Click">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ScissorsButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="RockButton" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="PaperButton" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
                <TextBlock Text="✂️" FontSize="36" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
        </UniformGrid>
    </Grid>
</Window>