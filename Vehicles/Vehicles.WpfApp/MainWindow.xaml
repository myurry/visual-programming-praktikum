<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicle Manager" Height="450" Width="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Registered Vehicles" FontSize="20" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,10"/>

        <!-- Vehicle List with Inline Move Controls -->
        <ListBox x:Name="LstVehicles" Grid.Row="1" Margin="0,0,0,15"
                 MouseDoubleClick="LstVehicles_MouseDoubleClick"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vehicle Details -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#222" Margin="0,0,8,0"/>
                                    <Border Background="#E8ECEF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VehicleType}" FontSize="11" FontWeight="SemiBold" Foreground="#495057"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Mileage, StringFormat='Mileage: {0} steps'}" FontSize="12" Foreground="#555"/>
                                <TextBlock Text="Double-click item to view full log" Foreground="Gray" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Inline Move Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Steps:" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" Foreground="#444"/>
                                <TextBox x:Name="TxtItemSteps" Text="10" Width="45" Height="26" 
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                         Margin="0,0,8,0"/>

                                <Button Content="Move" Height="26" Padding="12,0" 
                                        Click="MoveItem_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom Controls Area -->
        <DockPanel Grid.Row="2">
            <!-- Add Vehicle Button (Bottom Right) -->
            <Button Content="+ Add Vehicle" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Height="32" Padding="15,0" FontWeight="Bold" Background="#007ACC" Foreground="White"
                    Click="AddVehicle_Click"/>
        </DockPanel>
    </Grid>
</Window>