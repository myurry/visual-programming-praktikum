<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicle Manager" Height="450" Width="750"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <DataTemplate x:Key="VehicleItemTemplate">
            <Border Padding="8" Margin="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Vehicle Details -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#222" Margin="0,0,8,0"/>
                            <Border Background="#E8ECEF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VehicleType}" FontSize="11" FontWeight="SemiBold" Foreground="#495057"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Mileage, StringFormat='Mileage: {0} steps'}" FontSize="12" Foreground="#555"/>
                    </StackPanel>

                    <!-- Right: Steps Input, Drive, Swim, Log, and Remove Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Steps:" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" Foreground="#444"/>
                        <TextBox x:Name="TxtItemSteps" Text="10" Width="45" Height="26" 
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                 Margin="0,0,8,0"/>

                        <!-- Drive Button -->
                        <Button Content="Drive" Height="26" Padding="10,0" Margin="0,0,5,0"
                                Visibility="{Binding IsDrivable, Converter={StaticResource BoolToVisConverter}}"
                                Click="DriveItem_Click" Tag="{Binding}"/>

                        <!-- Swim Button -->
                        <Button Content="Swim" Height="26" Padding="10,0" Margin="0,0,5,0"
                                Visibility="{Binding IsSwimmable, Converter={StaticResource BoolToVisConverter}}"
                                Click="SwimItem_Click" Tag="{Binding}"/>

                        <!-- Log Button -->
                        <Button Content="Log" Height="26" Padding="10,0" Margin="0,0,5,0"
                                Click="ViewLogItem_Click" Tag="{Binding}"
                                Background="#6C757D" Foreground="White" FontWeight="SemiBold"/>

                        <!-- Remove Button -->
                        <Button Content="Remove" Height="26" Padding="10,0"
                                Click="RemoveItem_Click" Tag="{Binding}"
                                Background="#DC3545" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,15">
            <TabItem Header="Car Garage" FontSize="14" FontWeight="Bold">
                <ListBox x:Name="LstCars" 
                         Margin="0,10,0,0"
                         HorizontalContentAlignment="Stretch"
                         ItemTemplate="{StaticResource VehicleItemTemplate}"/>
            </TabItem>

            <TabItem Header="Boat Garage" FontSize="14" FontWeight="Bold">
                <ListBox x:Name="LstBoats" 
                         Margin="0,10,0,0"
                         HorizontalContentAlignment="Stretch"
                         ItemTemplate="{StaticResource VehicleItemTemplate}"/>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1">
            <Button Content="+ Add Vehicle" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Height="32" Padding="15,0" FontWeight="Bold" Background="#007ACC" Foreground="White"
                    Click="AddVehicle_Click"/>
        </DockPanel>
    </Grid>
</Window>