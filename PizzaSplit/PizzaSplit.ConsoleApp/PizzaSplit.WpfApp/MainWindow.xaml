<Window x:Class="PizzaSplit.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzaSplit.WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="470" Width="313">
    <Grid HorizontalAlignment="Left" Height="249" Margin="41,180,0,0" VerticalAlignment="Top" Width="234">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Row 1 -->
        <Button Content="7" Grid.Row="0" Grid.Column="0" Margin="2"/>
        <Button Content="8" Grid.Row="0" Grid.Column="1" Margin="2"/>
        <Button Content="9" Grid.Row="0" Grid.Column="2" Margin="2"/>
        <Button Content="/" Grid.Row="0" Grid.Column="3" Margin="2"/>

        <!-- Row 2 -->
        <Button Content="4" Grid.Row="1" Grid.Column="0" Margin="2"/>
        <Button Content="5" Grid.Row="1" Grid.Column="1" Margin="2"/>
        <Button Content="6" Grid.Row="1" Grid.Column="2" Margin="2"/>
        <Button Content="*" Grid.Row="1" Grid.Column="3" Margin="2" Click="Button_Click_1"/>

        <!-- Row 3 -->
        <Button Content="1" Grid.Row="2" Grid.Column="0" Margin="2"/>
        <Button Content="2" Grid.Row="2" Grid.Column="1" Margin="2"/>
        <Button Content="3" Grid.Row="2" Grid.Column="2" Margin="2"/>
        <Button Content="+" Grid.Row="2" Grid.Column="3" Margin="2"/>

        <!-- Row 4 (bottom) - unified right buttons into Evaluate -->
        <Button Content="0" Grid.Row="3" Grid.Column="0" Margin="2"/>
        <Button Content="C" Grid.Row="3" Grid.Column="1" Margin="2"/>
        <Button x:Name="Evaluate" Content="Send" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="2" Click="Evaluate_Click"/>
        <Label x:Name="actionReminder" Content="Please input cost per person:" HorizontalAlignment="Left" Margin="-32,-151,0,0" VerticalAlignment="Top" Height="35" Width="237" Grid.ColumnSpan="4" RenderTransformOrigin="0.503,0.568"/>
        <Label Content="0.00"
               FontFamily="Consolas"
               FontSize="36"
               Background="#FF1E1E1E"
               Foreground="White"
               BorderBrush="Gray"
               BorderThickness="1"
               Grid.ColumnSpan="4"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               HorizontalContentAlignment="Right"
               VerticalContentAlignment="Center"
               Padding="10"
               Height="72"
               Width="242"
               Margin="0,-111,2,0"/>
    </Grid>
</Window>
