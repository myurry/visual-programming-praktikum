<Window x:Class="PizzaSplit.WpfApp_MVP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzaSplit.WpfApp_MVP"
        mc:Ignorable="d"
        Title="MainWindow" Height="413" Width="310">
    <Grid>
        <TextBox x:Name="costPerPersonTextBox" HorizontalAlignment="Left" Margin="166,75,0,0" TextWrapping="Wrap" Text="0,00" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <Label Content="Cost per person:&#xD;&#xA;" HorizontalAlignment="Left" Margin="16,67,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="nLabel" HorizontalAlignment="Left" Margin="166,112,0,0" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <Label Content="Number of people (1-20):&#xA;" HorizontalAlignment="Left" Margin="16,109,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="tipBox" Content="Add 10% tip" HorizontalAlignment="Left" Margin="166,155,0,0" VerticalAlignment="Top" Checked="CheckBox_Checked"/>
        <Button x:Name="evaluateBtn" Content="Evaluate" HorizontalAlignment="Center" Margin="0,199,0,0" VerticalAlignment="Top" Click="Button_Click" Height="74" Width="200"/>
        <Label x:Name="resultLabel" Content="Result: " HorizontalAlignment="Left" Margin="30,315,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
